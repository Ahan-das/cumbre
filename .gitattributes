# Line endings: store and check out everything with LF, so Windows git stops
# rewriting files and reporting changes you did not make.
* text=auto eol=lf

# Binary assets git must never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.glb   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
